# Streamlit Community Cloud > App > Settings > Secrets
# Use a managed PostgreSQL provider (Neon/Supabase/etc.) with SSL enabled.
DATABASE_URL = "postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Set a unique strong password for every initial account before first deployment.
# The app stores salted PBKDF2 hashes, not these plaintext values.
[users]
niko = "GANTI_DENGAN_PASSWORD_KUAT"
agung = "GANTI_DENGAN_PASSWORD_KUAT"
iis = "GANTI_DENGAN_PASSWORD_KUAT"
nurhayat = "GANTI_DENGAN_PASSWORD_KUAT"
"23010202" = "GANTI_DENGAN_PASSWORD_KUAT"
"26090328" = "GANTI_DENGAN_PASSWORD_KUAT"
"26092377" = "GANTI_DENGAN_PASSWORD_KUAT"
