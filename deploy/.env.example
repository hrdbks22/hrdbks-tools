# Copy to deploy/.env and set a unique strong password.
POSTGRES_DB=hrd_tools
POSTGRES_USER=hrd_admin
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
# Keep database bound to localhost unless LAN access is intentionally required.
POSTGRES_BIND=127.0.0.1

# Sync node identity (must be a UUID registered in sync_nodes on both peers)
SYNC_NODE_ID=00000000-0000-4000-8000-000000000001
# Use the same high-entropy token only on the two authorized sync peers; rotate securely.
SYNC_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# HTTPS endpoint of the other node's sync API
SYNC_ENDPOINT=https://hrd-cloud.example.com
# PostgreSQL DSN used by the sync worker/API
DATABASE_URL=postgresql://hrd_admin:CHANGE_ME@127.0.0.1:5432/hrd_tools
